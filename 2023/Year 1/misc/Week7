def chain(lst: list[int]) -> int:
    track_1s = 0

    while track_1s < len(lst):
        if lst[track_1s] == 1:
            track_1s += 1

        else:
            return track_1s

    return track_1s


def largestposition(matrix: list[list[int]], row: int, col: int) -> int:
    # track variables
    count_rows = 0
    colsper_row = [0]
    area_result = []

    # count number of rows at desired column position that have 1s
    i = 0
    while row + i < len(matrix) and matrix[row + i][col] == 1:
        count_rows += 1
        i += 1

    # count number of columns at desired row position that have 1s,
    # iterate through all such rows and append them to a list
    # if the starting position is 0, returns 0 to represent no value
    for j in range(row, count_rows + row):
        count_columns = longest_chain(matrix[j][col:])
        colsper_row.append(count_columns)

    # if there are elements other than 0 in list, remove the first index
    if len(colsper_row) > 1:
        colsper_row.pop(0)

    # calculate biggest area of a rectangle with sides M x N
    # take the list from colsper_row and throw them all into a list

    for k in range(len(colsper_row)):
        subresult = colsper_row[:k + 1]
        value = min(subresult) * len(subresult)
        area_result.append(value)

    # calculate biggest rectangle
    # there are only three possible choices.
    # The col-wise rectangle, row-wise rectangle, and the row-col-wise rectangle
    return max(area_result)


